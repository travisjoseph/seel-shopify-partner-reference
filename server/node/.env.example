# Reference only. The server reads process.env and never loads a .env file;
# export these in your shell, process manager or secret store.

# Seel API. Sandbox is https://api-test.seel.com, production https://api.seel.com.
SEEL_API_BASE=https://api-test.seel.com
SEEL_API_KEY=
SEEL_API_VERSION=2.3.0
# Signs Seel webhooks (X-Seel-Hmac-SHA256). Seel provides one per environment.
SEEL_WEBHOOK_SECRET=
# The service type Seel assigned your app, used when the widget sends no type.
SEEL_SERVICE_TYPE=acme_shopify-wfp

# Required. Comma-separated *.myshopify.com domains the quote proxy serves.
# Any other admin_domain gets 403.
SEEL_ALLOWED_SHOPS=acme-demo.myshopify.com
# Storefront origins allowed to call the quote proxy from the browser.
SEEL_ALLOWED_ORIGINS=https://acme-demo.myshopify.com
# Path the widget posts quotes to.
SEEL_QUOTE_PATH=/seel/quotes

# Your Shopify app's API secret key. Signs Shopify webhooks.
SHOPIFY_API_SECRET=

# 1 only when a proxy you control sets X-Forwarded-For.
TRUST_PROXY=0
HOST=127.0.0.1
PORT=8787
